# Copy this file to .env and fill in ONE key. Never commit .env.
PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for the provider
# MODEL=gemini-2.5-flash
# MODEL=claude-sonnet-5-5

# Optional: dollars per million tokens for your model, so the trace "cost" is not 0.
# Look the numbers up on your provider's pricing page.
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
